{
  "name": "staff1st-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx src/setup.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@sentry/node": "^10.59.0",
    "dotenv": "^16.4.7",
    "openai": "^4.103.0",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
