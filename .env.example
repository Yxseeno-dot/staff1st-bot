DATABASE_URL=           # Same PostgreSQL connection string used by Locum1st
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-4o-mini
BOT_API_BASE=https://locum1st.net/api/bot
BOT_API_BEARER=         # Same value as Locum1st BOT_API_KEY
CENTRIFUGO_URL=         # Same self-hosted Centrifugo instance Locum1st uses, e.g. https://chat.locum1st.net
CENTRIFUGO_API_KEY=     # Same Centrifugo HTTP API key configured on Locum1st
BOT_USER_ID=bot-1stai   # Canonical 1stAi account seeded by Locum1st (do NOT run npm run setup — it mints a second, unrelated bot account)
POLL_INTERVAL_MS=5000   # How often to claim new messages (ms)
WORKER_CONCURRENCY=4
PORT=3000
SENTRY_DSN=
